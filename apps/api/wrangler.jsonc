// The whole app is one Cloudflare Worker: Static Assets serve the React SPA (apps/web/dist) from the edge,
// and /api/* runs the Hono API in src/worker.ts. One origin, so no proxy and no CORS.
// Deploys go through .github/workflows/deploy.yml; see README "Deploying".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pow-pickem",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-15",
  // postgres.js, node:crypto, node:async_hooks and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so client-side routes load the app.
    "not_found_handling": "single-page-application",
    // Only the API invokes the Worker; every other request is a free static asset.
    "run_worker_first": ["/api/*"]
  },
  // Each API request makes several queries in a row, so run it beside the Supabase project (AWS us-east-1).
  "placement": { "region": "aws:us-east-1" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // `wrangler hyperdrive create` (README, "Deploying"). Not a secret: it only works inside this account.
      "id": "1420fcc7f52241b7a4839d1a2d6e28c0"
    }
  ],
  // Notification email through Cloudflare Email Sending (README, "Email"). No API key: the binding is the
  // credential. Only the app's own sender may be used. Sending is off until the UNSUBSCRIBE_SECRET secret is set.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@pow-pickem.com"] }],
  // The email job (src/worker.ts `scheduled`): queues pick reminders due at 7pm league time and sends or retries
  // what's in the outbox. It's idempotent, so a late or doubled run is harmless.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Secrets (`wrangler secret put`): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, optionally OPERATOR_USER_IDS, and
  // UNSUBSCRIBE_SECRET to turn email on. Optional vars: EMAIL_FROM, EMAIL_DAILY_LIMIT, EMAIL_MONTHLY_LIMIT, and
  // AUTH_PROVIDERS ("google" shows Continue with Google; add it here only once Google is set up in Supabase Auth,
  // docs/auth-providers.md).
  "vars": { "NODE_ENV": "production", "APP_URL": "https://www.pow-pickem.com" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "upload_source_maps": true
}
