{
  "name": "@picks/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev:worker": "node ../../scripts/worker-dev.mjs",
    "cf-typegen": "wrangler types"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@picks/db": "workspace:*",
    "@picks/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
