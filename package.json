{
  "name": "football-weekly-picks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/mobile-dev.mjs --web",
    "worker:dev": "pnpm --filter @picks/api dev:worker",
    "build": "pnpm --filter @picks/mobile build:web && pnpm --filter @picks/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:status": "node scripts/supabase.mjs status",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:generate": "pnpm --filter @picks/db generate",
    "db:erd": "pnpm --filter @picks/db erd",
    "db:migrate:custom": "pnpm --filter @picks/db generate:custom",
    "test:contract": "pnpm --filter @picks/api test:contract",
    "test:e2e": "pnpm --filter @picks/e2e e2e",
    "test:e2e:ui": "pnpm --filter @picks/e2e e2e:ui",
    "test:all": "pnpm test && pnpm test:e2e",
    "env:local": "node scripts/supabase-env.mjs > .env",
    "playwright:install": "pnpm --filter @picks/e2e exec playwright install --with-deps chromium webkit",
    "sb": "node scripts/supabase.mjs",
    "ports": "node scripts/ports.mjs",
    "icons": "node scripts/icons.mjs",
    "mobile": "node scripts/mobile-dev.mjs",
    "mobile:prod": "pnpm --filter @picks/mobile exec expo start --go",
    "mobile:eas": "pnpm --filter @picks/mobile exec npx --yes eas-cli@27.10.0",
    "mobile:check": "pnpm --filter @picks/mobile typecheck && pnpm --filter @picks/mobile test",
    "mobile:export": "pnpm --filter @picks/mobile export:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "supabase": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
