# `pnpm env:local` writes .env for you from the running local stack (after `pnpm db:start`).
# This file documents the variables the API needs.
# Ports shown are the defaults (main checkout). Git worktrees get their own; see `pnpm ports`.
PORT=8787
WEB_PORT=5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" in `pnpm db:status` (older CLIs call it the "anon key").
SUPABASE_PUBLISHABLE_KEY=
