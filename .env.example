# `pnpm env:local` writes .env for you from the running local stack (after `pnpm db:start`).
# This file documents the variables the API needs.
# Ports shown are the defaults (main checkout). Git worktrees get their own; see `pnpm ports`.
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" in `pnpm db:status` (older CLIs call it the "anon key").
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated user ids that may open the operator screen (/operator: feedback inbox and app-wide counts).
# Locally it's the seeded admin@example.com; everyone else gets a 404 there.
OPERATOR_USER_IDS=11111111-1111-4111-8111-000000000001
# Local testing only: start the API's clock at this moment (ISO 8601 with an offset); it keeps running from there.
# Pick locks and week phases follow it, in the API and in the app (which reads the offset from /api/config).
# The API refuses to start with it when NODE_ENV=production. `pnpm env:local` rewrites .env, so you can also pass it
# inline: CLOCK_OVERRIDE=2026-09-13T12:30:00-04:00 pnpm dev
# CLOCK_OVERRIDE=

# ---------- Email (optional; without UNSUBSCRIBE_SECRET the API sends no notification emails) ----------
# The local stack's test inbox (Mailpit, see `pnpm ports`). Local Auth and the API both send to it, and E2E tests
# read it. Production sends through the Worker's Cloudflare Email Sending binding instead; INBOX_URL is refused
# when NODE_ENV=production.
# Links in emails open the Expo web preview of `pnpm dev`; `pnpm worker:dev` points them at the Worker instead.
APP_URL=http://localhost:8081
INBOX_URL=http://127.0.0.1:54324
UNSUBSCRIBE_SECRET=local-only-unsubscribe-secret-not-for-production
# Most notification emails per UTC day and month: a safety cap. Production defaults are 1000 / 10000;
# `pnpm env:local` raises them further, since the test inbox has no quota.
EMAIL_DAILY_LIMIT=10000
EMAIL_MONTHLY_LIMIT=100000
# EMAIL_FROM=POW Pick'em <noreply@pow-pickem.com>

# ---------- Web Push (optional; set all three or none) ----------
# Off locally. To try it, generate a pair with `node scripts/vapid-keys.mjs`. Production keeps its pair in Worker
# secrets (README, "Push notifications").
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Native Expo push (independent of Web Push VAPID configuration).
# Enable only after configuring the EAS project and APNs credentials.
EXPO_PUSH_ENABLED=false
# Optional Expo enhanced push security access token (server-only).
# EXPO_ACCESS_TOKEN=
